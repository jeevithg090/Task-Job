# Copy to .env (or export in your shell / deployment platform) and fill in.
# The server reads these from the process environment; it does not load .env itself.

# REQUIRED. HMAC key for signing JWTs, at least 32 bytes.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# TCP port to listen on.
PORT=8080

# SQLite database file.
DATABASE_PATH=./users.db

# Token lifetime (Go duration, e.g. 24h, 30m).
JWT_TTL=24h

# Comma-separated origins allowed to call the API from a browser on another
# origin. Leave empty for same-origin only; "*" allows any origin.
CORS_ALLOWED_ORIGINS=

# Optional bootstrap admin, created on startup if the email is not registered.
# Self-service signup can only create regular users.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
